# Wiktionary contribution tooling (tools/wiktionary).
# The records/ directory is deliberately NOT ignored - it is the audit trail of
# every edit the tool has made.
tools/wiktionary/.venv/
tools/wiktionary/user-config.py
tools/wiktionary/user-password.py
tools/wiktionary/*.lwp
tools/wiktionary/work/

# Pywikibot's own scratch, written into PYWIKIBOT_DIR
tools/wiktionary/apicache/
tools/wiktionary/logs/
tools/wiktionary/throttle.ctrl
__pycache__/
*.pyc

.DS_Store

# Prerendered pages, written by build/lib/prerender.mjs on every build: ~7,110
# HTML files, about 75 MB. Generated, so not committed - Cloudflare Pages runs
# `npm run build` and writes them at deploy time.
#
# One .html per address: /yo/gba/take is public/yo/gba/take.html and /about is
# public/about.html. Three depths because addresses are at most three segments
# deep. public/index.html is the shell they are all built from and is the one
# .html in git, so it is excepted below - the rule above it would otherwise
# start ignoring the template and the build would lose its own source.
/public/*.html
!/public/index.html
/public/*/*.html
/public/*/*/*.html

/public/sitemap.xml
/public/_redirects
/public/data/version.json

# tools/slugs work: the review worksheets, one per letter. Generated from the
# ledger, edited by hand, read back, and then disposable. data/url-slugs.json is
# the committed artifact - that one is the point.
tools/slugs/work/
tools/slugs/.venv/

# Written by `npm run trace -- --json`, a measurement of one machine on one
# afternoon. Never a checked-in fact.
tools/trace/paint-profile.json

# The PageSpeed Insights API key, read by tools/trace/psi-runs.mjs. Ignored
# before the file was created, not after: a key committed once is a key that
# has to be revoked, and git remembers it whether or not the next commit
# removes it. .env.example is the committed half and holds no secret.
.env
.env.local
