# Copy this file to .env.local and fill in the value. .env.local is ignored by
# git; this file is committed and must never hold a real key.
#
#   cp .env.example .env.local
#
# Read automatically by tools/trace/psi-runs.mjs. Nothing else in the project
# needs it, and the site itself has no server and no secrets - this exists only
# so the PageSpeed measuring script can raise its own rate limit.

# From https://developers.google.com/speed/docs/insights/v5/get-started
# Free. Restrict it to the "PageSpeed Insights API" when Google offers to.
PSI_API_KEY=
