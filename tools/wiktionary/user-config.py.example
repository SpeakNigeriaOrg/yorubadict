# Copy to user-config.py (gitignored) and put your own Wiktionary username in.
#
# This is your ordinary account, not a bot account. en.wiktionary's own advice
# is to try Pywikibot under your own account first and see whether it helps; a
# separate bot account and a bot flag are for unattended, high-volume work,
# which this is not.
family = 'wiktionary'
mylang = 'en'

usernames['wiktionary']['en'] = 'YourWiktionaryUsername'

# Identify the tool and a contact address, per Wikimedia's User-Agent policy.
# Pywikibot's default format already carries the script name and its own
# version; this is the part only we can supply. Do not override
# user_agent_format - its placeholders changed in Pywikibot 11.
user_agent_description = (
    'yorubadict etymid; https://github.com/SpeakNigeriaOrg/yorubadict; '
    'admin@speaknigeria.org'
)

# Ten seconds between saves. Pywikibot's default, left explicit because this
# tool's whole claim is that it is not in a hurry.
put_throttle = 10

# Never claim the bot flag. Every edit here is confirmed by a person, and
# en.wiktionary requires approval before an account may mark edits as a bot's.
