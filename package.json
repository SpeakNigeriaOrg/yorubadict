{
  "name": "yorubadict",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sọ̀rọ̀ Sókè, The People’s Yorùbá Dictionary — a free, fully static, client-side Yorùbá dictionary built from a Kaikki Wiktionary JSONL extract.",
  "scripts": {
    "build": "node build/normalize.mjs",
    "test": "node --test",
    "check:search": "node build/check-search-agreement.mjs",
    "build:custom": "node build/normalize.mjs",
    "serve": "node server/dev-server.mjs",
    "start": "npm run build && npm run serve",
    "trace": "node tools/trace/paint-profile.mjs",
    "trace:prod": "node tools/trace/paint-profile.mjs --url=https://yorubadict.com/",
    "psi": "node tools/trace/psi-runs.mjs",
    "test:paint": "PAINT_TEST=1 node --test test/paint-budget.test.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
